  "sources": [
    {
      "manifest": {
        "egress": {
          "description": "Reads your pull requests and review requests from GitHub (or your GitHub Enterprise host).",
          "externalAi": false,
          "hosts": [
            "api.github.com",
            "github.com",
            "avatars.githubusercontent.com"
          ]
        },
        "fields": [
          {
            "defaultValue": "https://github.com",
            "help": null,
            "isOptional": false,
            "isSecret": false,
            "key": "host",
            "label": "Host",
            "placeholder": "https://github.com"
          },
          {
            "defaultValue": "",
            "help": "Classic token with the repo and read:org scopes.",
            "isOptional": false,
            "isSecret": true,
            "key": "token",
            "label": "Personal access token",
            "placeholder": ""
          }
        ],
        "id": "github",
        "logo": "github",
        "name": "GitHub",
        "setupLabel": "Create a token",
        "setupSteps": [
          "Click “Create a token”: GitHub opens with the repo and read:org scopes selected.",
          "Set an expiration, click “Generate token” and paste it below."
        ],
        "setupUrl": "{host}/settings/tokens/new?scopes=repo,read:org&description=Remora",
        "summary": "Pull requests you opened and review requests. Works with GitHub Enterprise."
      },
      "refusal": null
    },
    {
      "manifest": {
        "egress": {
          "description": "Reads your merge requests, approvals and pipelines from your GitLab host.",
          "externalAi": false,
          "hosts": [
            "gitlab.com"
          ]
        },
        "fields": [
          {
            "defaultValue": "https://gitlab.com",
            "help": null,
            "isOptional": false,
            "isSecret": false,
            "key": "host",
            "label": "Host",
            "placeholder": "https://gitlab.com"
          },
          {
            "defaultValue": "",
            "help": "Token with the read_api scope.",
            "isOptional": false,
            "isSecret": true,
            "key": "token",
            "label": "Personal access token",
            "placeholder": ""
          }
        ],
        "id": "gitlab",
        "logo": "gitlab",
        "name": "GitLab",
        "setupLabel": "Create a token",
        "setupSteps": [
          "If you use self-hosted GitLab, set the host first.",
          "Click “Create a token”: GitLab opens with the read_api scope selected.",
          "Click “Create personal access token” and paste it below."
        ],
        "setupUrl": "{host}/-/user_settings/personal_access_tokens?name=Remora&scopes=read_api",
        "summary": "Merge requests you opened and those you review. Works with self-hosted GitLab."
      },
      "refusal": null
    },
    {
      "manifest": {
        "egress": {
          "description": "Searches your recent mentions and direct messages in Slack.",
          "externalAi": false,
          "hosts": [
            "slack.com"
          ]
        },
        "fields": [
          {
            "defaultValue": "",
            "help": "A user token (xoxp-…) with the search:read scope.",
            "isOptional": false,
            "isSecret": true,
            "key": "token",
            "label": "User OAuth token",
            "placeholder": ""
          },
          {
            "defaultValue": "3",
            "help": null,
            "isOptional": false,
            "isSecret": false,
            "key": "days",
            "label": "Look back (days)",
            "placeholder": "3"
          }
        ],
        "id": "slack",
        "logo": "slack",
        "name": "Slack",
        "setupLabel": "Create the Slack app",
        "setupSteps": [
          "Click “Create the Slack app”, pick your workspace, then Next and Create. The app comes pre-filled.",
          "In the app page, open “Install App” and click “Install to <workspace>”, then Allow.",
          "Copy the “User OAuth Token” (it starts with xoxp-) and paste it below."
        ],
        "setupUrl": "https://api.slack.com/apps?new_app=1&manifest_json=%7B%22display_information%22%3A%7B%22name%22%3A%22Remora%22%2C%22description%22%3A%22Mentions+and+DMs+in+your+inbox%22%7D%2C%22oauth_config%22%3A%7B%22scopes%22%3A%7B%22user%22%3A%5B%22search%3Aread%22%5D%7D%7D%2C%22settings%22%3A%7B%22org_deploy_enabled%22%3Afalse%2C%22socket_mode_enabled%22%3Afalse%2C%22token_rotation_enabled%22%3Afalse%7D%7D",
        "summary": "Mentions and direct messages from the last few days."
      },
      "refusal": null
    },
    {
      "manifest": {
        "egress": {
          "description": "Reads issues assigned to you and your Linear inbox.",
          "externalAi": false,
          "hosts": [
            "api.linear.app",
            "public.linear.app"
          ]
        },
        "fields": [
          {
            "defaultValue": "",
            "help": "Linear → Settings → Security & access → Personal API keys.",
            "isOptional": false,
            "isSecret": true,
            "key": "token",
            "label": "Personal API key",
            "placeholder": ""
          }
        ],
        "id": "linear",
        "logo": "linear",
        "name": "Linear",
        "setupLabel": "Create an API key",
        "setupSteps": [
          "Click “Create an API key”: Linear opens its Security & access settings.",
          "Under Personal API keys, create a key named Remora (read access is enough) and paste it below."
        ],
        "setupUrl": "https://linear.app/settings/account/security",
        "summary": "Issues assigned to you, and the mentions and comments waiting in your Linear inbox."
      },
      "refusal": null
    }
  ]
