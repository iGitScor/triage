{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Remora window may do: the commands it calls, each declared in build.rs and granted here, and listening to events. Links, notifications and start at login go through Rust only.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-hide",
    "allow-inbox",
    "allow-refresh",
    "allow-toggle-done",
    "allow-toggle-pin",
    "allow-start",
    "allow-stop",
    "allow-clear-done",
    "allow-undo",
    "allow-snooze",
    "allow-unsnooze",
    "allow-presets",
    "allow-slider-date",
    "allow-slider-progress",
    "allow-add-reminder",
    "allow-open-item",
    "allow-open-setup",
    "allow-sources",
    "allow-accounts",
    "allow-connect",
    "allow-reconnect",
    "allow-rename-account",
    "allow-disconnect",
    "allow-settings",
    "allow-set-preferences",
    "allow-set-autostart",
    "allow-erase-local-data",
    "allow-update-status",
    "allow-check-for-updates",
    "allow-install-update",
    "allow-hide",
    "allow-quit",
    "allow-snooze-advice",
    "allow-dismiss-insight",
    "allow-spread",
    "allow-align-returns",
    "allow-snooze-many",
    "allow-sweep",
    "allow-waiting-draft",
    "allow-review-queue",
    "allow-make-brief",
    "allow-summarize",
    "allow-triage",
    "allow-apply-triage",
    "allow-discard-triage"
  ]
}
