{
  "name": "remora-windows",
  "private": true,
  "version": "0.2.0",
  "description": "Remora for Windows: the tray app's interface (Svelte), shell in src-tauri.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "i18n": "python3 scripts/make-i18n.py",
    "icons": "node scripts/render-icons.mjs && tauri icon --output=src-tauri/icons src-tauri/icons/source.png && rm -rf src-tauri/icons/android src-tauri/icons/ios",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@tauri-apps/api": "^2.12.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^28.1.0",
    "playwright-core": "^1.64.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
