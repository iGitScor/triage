{
  // Remora's website, served as static assets on Cloudflare: python3 build.py, then npx wrangler deploy.
  // public/_headers sets the security headers; there is no server code.
  "name": "remora",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public",
    // Unknown URLs get the bilingual public/404.html with a 404 status.
    "not_found_handling": "404-page"
  },
  // The pages use this domain for canonical links and the sitemap (ORIGIN in build.py).
  "routes": [{ "pattern": "triage.iscor.me", "custom_domain": true }],
  // No request logs: the privacy page says nothing is tracked.
  "observability": { "enabled": false }
}
