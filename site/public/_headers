# Cloudflare static assets headers (https://developers.cloudflare.com/workers/static-assets/headers/).
# When several rules match, Cloudflare joins their values, so each page family gets exactly one
# Content-Security-Policy: two would both apply.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  # Subdomains too. Not preloaded: browsers only list apex domains, and this site is a subdomain.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# The marketing pages: only this origin's scripts, styles, fonts and images; no inline code (their
# JSON-LD is a data block, which CSP does not run); no framing.
/
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'none'
/index.html
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'none'
/404.html
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'none'
/en/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'none'
/fr/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'none'

# The docs (VitePress): its few inline scripts (theme, platform, page map) are allowed by their hashes, written by
# site/csp.py after each docs build, never 'unsafe-inline'. Mermaid draws with inline styles. Everything comes from
# this origin.
/docs/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-DQUgNM9X0iH2019NkUxeBvnBoEoRKkHBc/I0iLqPNPA=' 'sha256-La1r0VSk0Po4KFI0duEKhmPu+u0I416JW3oONqtdf4M=' 'sha256-ww1ZBwXwb1lM0lPh8J1QcUPMkjadx9qcl/iMhzBkP78='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'none'

# The site's own files and screenshots: a day in the cache, then revalidated in the background.
/site/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
# The docs' content-hashed bundles.
/docs/assets/*
  Cache-Control: public, max-age=31536000, immutable
