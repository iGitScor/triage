<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by scripts/make-policy-files.py. -->
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Remora</displayName>
  <description>Remora's managed settings (fr.igitscor.remora).</description>
  <resources>
    <stringTable>
      <string id="Remora">Remora</string>
      <string id="SUPPORTED_Remora">Remora 0.6 or later</string>
      <string id="AllowedPlugins">Allowed tools</string>
      <string id="AllowedPlugins_Help">The tools that may be connected and refreshed, by plugin ID: github, gitlab, bitbucket, azuredevops, slack, linear, jira, notion, microsoft, claude-code, claude, openai. Any other is refused.</string>
      <string id="AllowExternalAI">Allow external AI</string>
      <string id="AllowExternalAI_Help">Allow the assistant to send inbox content off the computer: to Anthropic for Claude, to the configured server for OpenAI-compatible.</string>
      <string id="AllowRemoteImages">Allow avatars</string>
      <string id="AllowRemoteImages_Help">Load avatars, from the hosts of allowed tools only.</string>
      <string id="AIExcludedSources">Tools kept from the assistant</string>
      <string id="AIExcludedSources_Help">Tools whose items never reach the assistant (brief, summaries, triage); reminders for the user's own reminders. Added to the user's choice.</string>
      <string id="AllowedAIModels">Allowed AI models</string>
      <string id="AllowedAIModels_Help">The models the assistant may use, by any provider's IDs. A model not listed is replaced by the first one.</string>
      <string id="AllowedAIServers">Allowed AI servers</string>
      <string id="AllowedAIServers_Help">The servers the OpenAI-compatible assistant may use, as URL prefixes (scheme, host, port and path).</string>
      <string id="AIServer">AI server</string>
      <string id="AIServer_Help">The server the OpenAI-compatible assistant uses, filled in and locked in Settings.</string>
      <string id="AllowLocalAI">Allow an AI server on this computer</string>
      <string id="AllowLocalAI_Help">A server on this computer (localhost): allowed even with external AI off, or refused.</string>
      <string id="HiddenContentSources">Hide message content</string>
      <string id="HiddenContentSources_Help">Tools whose notifications say where something happened, not what was written; reminders for the user's own reminders. Added to the user's choice.</string>
      <string id="RefreshMinutes">Refresh interval</string>
      <string id="RefreshMinutes_Help">How often tools are checked, from 1 to 60 minutes. Locked in Settings.</string>
      <string id="OpenInApps">Open in desktop apps</string>
      <string id="OpenInApps_Help">Open Slack and Linear items in their desktop app when installed; disabled always opens the web page.</string>
      <string id="ClaudeCodePath">Claude Code path</string>
      <string id="ClaudeCodePath_Help">The claude program Remora runs, instead of the one found or entered. It must still be named claude and pass Remora's checks.</string>
      <string id="MicrosoftTenant">Microsoft 365 tenant</string>
      <string id="MicrosoftTenant_Help">The organization's Microsoft Entra tenant, by domain or ID, for signing in to Microsoft 365. Filled in and locked in the connect form.</string>
      <string id="MicrosoftClientID">Microsoft 365 client ID</string>
      <string id="MicrosoftClientID_Help">The application (client) ID of the app the organization registered in Microsoft Entra for Remora. Filled in and locked in the connect form.</string>
      <string id="AutomaticUpdates">Automatic updates</string>
      <string id="AutomaticUpdates_Help">Enabled: check for a new version once a day, locked on. Disabled: no update check at all.</string>
    </stringTable>
    <presentationTable>
      <presentation id="AllowedPlugins"><multiTextBox refId="AllowedPlugins">One value per line</multiTextBox></presentation>
      <presentation id="AIExcludedSources"><multiTextBox refId="AIExcludedSources">One value per line</multiTextBox></presentation>
      <presentation id="AllowedAIModels"><multiTextBox refId="AllowedAIModels">One value per line</multiTextBox></presentation>
      <presentation id="AllowedAIServers"><multiTextBox refId="AllowedAIServers">One value per line</multiTextBox></presentation>
      <presentation id="AIServer"><textBox refId="AIServer"><label>AI server</label></textBox></presentation>
      <presentation id="HiddenContentSources"><multiTextBox refId="HiddenContentSources">One value per line</multiTextBox></presentation>
      <presentation id="RefreshMinutes"><decimalTextBox refId="RefreshMinutes" defaultValue="5">Minutes</decimalTextBox></presentation>
      <presentation id="ClaudeCodePath"><textBox refId="ClaudeCodePath"><label>Claude Code path</label></textBox></presentation>
      <presentation id="MicrosoftTenant"><textBox refId="MicrosoftTenant"><label>Microsoft 365 tenant</label></textBox></presentation>
      <presentation id="MicrosoftClientID"><textBox refId="MicrosoftClientID"><label>Microsoft 365 client ID</label></textBox></presentation>
    </presentationTable>
  </resources>
