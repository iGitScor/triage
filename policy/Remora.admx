<?xml version="1.0" encoding="utf-8"?>
<!-- Remora's Group Policy template, every managed key. Generated by scripts/make-policy-files.py. Copy it to
     PolicyDefinitions (or the central store) with en-US\Remora.adml and fr-FR\Remora.adml. -->
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="remora" namespace="Remora.Policies.Remora" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />
  <supportedOn>
    <definitions>
      <definition name="SUPPORTED_Remora" displayName="$(string.SUPPORTED_Remora)" />
    </definitions>
  </supportedOn>
  <categories>
    <category name="Remora" displayName="$(string.Remora)" />
  </categories>
  <policies>
    <policy name="AllowedPlugins" class="Both" displayName="$(string.AllowedPlugins)" explainText="$(string.AllowedPlugins_Help)" key="Software\Policies\Remora" presentation="$(presentation.AllowedPlugins)">
      <parentCategory ref="Remora" />
      <supportedOn ref="SUPPORTED_Remora" />
      <elements>
        <multiText id="AllowedPlugins" valueName="AllowedPlugins" />
      </elements>
    </policy>
    <policy name="AllowExternalAI" class="Both" displayName="$(string.AllowExternalAI)" explainText="$(string.AllowExternalAI_Help)" key="Software\Policies\Remora" valueName="AllowExternalAI">
      <parentCategory ref="Remora" />
      <supportedOn ref="SUPPORTED_Remora" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="AllowRemoteImages" class="Both" displayName="$(string.AllowRemoteImages)" explainText="$(string.AllowRemoteImages_Help)" key="Software\Policies\Remora" valueName="AllowRemoteImages">
      <parentCategory ref="Remora" />
      <supportedOn ref="SUPPORTED_Remora" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="AIExcludedSources" class="Both" displayName="$(string.AIExcludedSources)" explainText="$(string.AIExcludedSources_Help)" key="Software\Policies\Remora" presentation="$(presentation.AIExcludedSources)">
      <parentCategory ref="Remora" />
      <supportedOn ref="SUPPORTED_Remora" />
      <elements>
        <multiText id="AIExcludedSources" valueName="AIExcludedSources" />
      </elements>
    </policy>
    <policy name="AllowedAIModels" class="Both" displayName="$(string.AllowedAIModels)" explainText="$(string.AllowedAIModels_Help)" key="Software\Policies\Remora" presentation="$(presentation.AllowedAIModels)">
      <parentCategory ref="Remora" />
      <supportedOn ref="SUPPORTED_Remora" />
      <elements>
        <multiText id="AllowedAIModels" valueName="AllowedAIModels" />
      </elements>
    </policy>
    <policy name="AllowedAIServers" class="Both" displayName="$(string.AllowedAIServers)" explainText="$(string.AllowedAIServers_Help)" key="Software\Policies\Remora" presentation="$(presentation.AllowedAIServers)">
      <parentCategory ref="Remora" />
      <supportedOn ref="SUPPORTED_Remora" />
      <elements>
        <multiText id="AllowedAIServers" valueName="AllowedAIServers" />
      </elements>
    </policy>
    <policy name="AIServer" class="Both" displayName="$(string.AIServer)" explainText="$(string.AIServer_Help)" key="Software\Policies\Remora" presentation="$(presentation.AIServer)">
      <parentCategory ref="Remora" />
      <supportedOn ref="SUPPORTED_Remora" />
      <elements>
        <text id="AIServer" valueName="AIServer" />
      </elements>
    </policy>
    <policy name="AllowLocalAI" class="Both" displayName="$(string.AllowLocalAI)" explainText="$(string.AllowLocalAI_Help)" key="Software\Policies\Remora" valueName="AllowLocalAI">
      <parentCategory ref="Remora" />
      <supportedOn ref="SUPPORTED_Remora" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="HiddenContentSources" class="Both" displayName="$(string.HiddenContentSources)" explainText="$(string.HiddenContentSources_Help)" key="Software\Policies\Remora" presentation="$(presentation.HiddenContentSources)">
      <parentCategory ref="Remora" />
      <supportedOn ref="SUPPORTED_Remora" />
      <elements>
        <multiText id="HiddenContentSources" valueName="HiddenContentSources" />
      </elements>
    </policy>
    <policy name="RefreshMinutes" class="Both" displayName="$(string.RefreshMinutes)" explainText="$(string.RefreshMinutes_Help)" key="Software\Policies\Remora" presentation="$(presentation.RefreshMinutes)">
      <parentCategory ref="Remora" />
      <supportedOn ref="SUPPORTED_Remora" />
      <elements>
        <decimal id="RefreshMinutes" valueName="RefreshMinutes" minValue="1" maxValue="60" />
      </elements>
    </policy>
    <policy name="OpenInApps" class="Both" displayName="$(string.OpenInApps)" explainText="$(string.OpenInApps_Help)" key="Software\Policies\Remora" valueName="OpenInApps">
      <parentCategory ref="Remora" />
      <supportedOn ref="SUPPORTED_Remora" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="ClaudeCodePath" class="Both" displayName="$(string.ClaudeCodePath)" explainText="$(string.ClaudeCodePath_Help)" key="Software\Policies\Remora" presentation="$(presentation.ClaudeCodePath)">
      <parentCategory ref="Remora" />
      <supportedOn ref="SUPPORTED_Remora" />
      <elements>
        <text id="ClaudeCodePath" valueName="ClaudeCodePath" />
      </elements>
    </policy>
    <policy name="MicrosoftTenant" class="Both" displayName="$(string.MicrosoftTenant)" explainText="$(string.MicrosoftTenant_Help)" key="Software\Policies\Remora" presentation="$(presentation.MicrosoftTenant)">
      <parentCategory ref="Remora" />
      <supportedOn ref="SUPPORTED_Remora" />
      <elements>
        <text id="MicrosoftTenant" valueName="MicrosoftTenant" />
      </elements>
    </policy>
    <policy name="MicrosoftClientID" class="Both" displayName="$(string.MicrosoftClientID)" explainText="$(string.MicrosoftClientID_Help)" key="Software\Policies\Remora" presentation="$(presentation.MicrosoftClientID)">
      <parentCategory ref="Remora" />
      <supportedOn ref="SUPPORTED_Remora" />
      <elements>
        <text id="MicrosoftClientID" valueName="MicrosoftClientID" />
      </elements>
    </policy>
    <policy name="AutomaticUpdates" class="Both" displayName="$(string.AutomaticUpdates)" explainText="$(string.AutomaticUpdates_Help)" key="Software\Policies\Remora" valueName="AutomaticUpdates">
      <parentCategory ref="Remora" />
      <supportedOn ref="SUPPORTED_Remora" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
  </policies>
</policyDefinitions>
