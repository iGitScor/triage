<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by scripts/make-policy-files.py. -->
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Remora</displayName>
  <description>Réglages gérés de Remora (fr.igitscor.remora).</description>
  <resources>
    <stringTable>
      <string id="Remora">Remora</string>
      <string id="SUPPORTED_Remora">Remora 0.6 ou ultérieure</string>
      <string id="AllowedPlugins">Outils autorisés</string>
      <string id="AllowedPlugins_Help">Les outils qui peuvent être connectés et actualisés, par identifiant : github, gitlab, bitbucket, azuredevops, slack, linear, jira, notion, microsoft, claude-code, claude, openai. Tout autre est refusé.</string>
      <string id="AllowExternalAI">Autoriser l’IA externe</string>
      <string id="AllowExternalAI_Help">Autoriser l’assistant à envoyer le contenu de la boîte hors de l’ordinateur : à Anthropic pour Claude, au serveur configuré pour OpenAI-compatible.</string>
      <string id="AllowRemoteImages">Autoriser les avatars</string>
      <string id="AllowRemoteImages_Help">Charger les avatars, depuis les adresses des outils autorisés seulement.</string>
      <string id="AIExcludedSources">Outils cachés à l’assistant</string>
      <string id="AIExcludedSources_Help">Les outils dont les éléments ne parviennent jamais à l’assistant (brief, résumés, tri) ; reminders pour les rappels de l’utilisateur. S’ajoute au choix de l’utilisateur.</string>
      <string id="AllowedAIModels">Modèles d’IA autorisés</string>
      <string id="AllowedAIModels_Help">Les modèles que l’assistant peut utiliser, avec les identifiants de n’importe quel fournisseur. Un modèle absent est remplacé par le premier.</string>
      <string id="AllowedAIServers">Serveurs d’IA autorisés</string>
      <string id="AllowedAIServers_Help">Les serveurs que l’assistant OpenAI-compatible peut utiliser, en préfixes d’URL (schéma, hôte, port et chemin).</string>
      <string id="AIServer">Serveur d’IA</string>
      <string id="AIServer_Help">Le serveur qu’utilise l’assistant OpenAI-compatible, rempli et verrouillé dans les Réglages.</string>
      <string id="AllowLocalAI">Autoriser un serveur d’IA sur cet ordinateur</string>
      <string id="AllowLocalAI_Help">Un serveur sur cet ordinateur (localhost) : autorisé même sans IA externe, ou refusé.</string>
      <string id="AllowLocalAPI">Autoriser les scripts et les agents à lire la boîte</string>
      <string id="AllowLocalAPI_Help">La commande remora et le serveur MCP pour les agents d’IA de cet ordinateur (Claude Desktop, Claude Code, Gemini CLI). Désactivé : seule l’app peut lire la boîte.</string>
      <string id="AIDailyLimit">Requêtes de l’assistant par jour</string>
      <string id="AIDailyLimit_Help">Le nombre maximal de requêtes que l’assistant peut envoyer chaque jour (un brief, un résumé ou un tri en est une), de 1 à 10000. Au-delà, l’assistant attend le lendemain. Verrouillé dans les Réglages.</string>
      <string id="HiddenContentSources">Masquer le contenu des messages</string>
      <string id="HiddenContentSources_Help">Les outils dont les notifications disent où quelque chose s’est passé, pas ce qui a été écrit ; reminders pour les rappels de l’utilisateur. S’ajoute au choix de l’utilisateur.</string>
      <string id="RefreshMinutes">Fréquence d’actualisation</string>
      <string id="RefreshMinutes_Help">La fréquence de vérification des outils, de 1 à 60 minutes. Verrouillée dans les Réglages.</string>
      <string id="OpenInApps">Ouvrir dans les apps</string>
      <string id="OpenInApps_Help">Ouvrir les éléments Slack et Linear dans leur app quand elle est installée ; désactivé, ouvre toujours la page web.</string>
      <string id="ClaudeCodePath">Chemin de Claude Code</string>
      <string id="ClaudeCodePath_Help">Le programme claude que Remora exécute, au lieu de celui trouvé ou saisi. Il doit toujours s’appeler claude et passer les vérifications de Remora.</string>
      <string id="MicrosoftTenant">Tenant Microsoft 365</string>
      <string id="MicrosoftTenant_Help">Le tenant Microsoft Entra de l’organisation, par domaine ou identifiant, pour la connexion à Microsoft 365. Rempli et verrouillé dans le formulaire de connexion.</string>
      <string id="MicrosoftClientID">ID client Microsoft 365</string>
      <string id="MicrosoftClientID_Help">L’identifiant d’application (client) de l’app que l’organisation a inscrite dans Microsoft Entra pour Remora. Rempli et verrouillé dans le formulaire de connexion.</string>
      <string id="AutomaticUpdates">Mises à jour automatiques</string>
      <string id="AutomaticUpdates_Help">Activé : vérifier une nouvelle version une fois par jour, verrouillé. Désactivé : aucune vérification.</string>
    </stringTable>
    <presentationTable>
      <presentation id="AllowedPlugins"><multiTextBox refId="AllowedPlugins">Une valeur par ligne</multiTextBox></presentation>
      <presentation id="AIExcludedSources"><multiTextBox refId="AIExcludedSources">Une valeur par ligne</multiTextBox></presentation>
      <presentation id="AllowedAIModels"><multiTextBox refId="AllowedAIModels">Une valeur par ligne</multiTextBox></presentation>
      <presentation id="AllowedAIServers"><multiTextBox refId="AllowedAIServers">Une valeur par ligne</multiTextBox></presentation>
      <presentation id="AIServer"><textBox refId="AIServer"><label>Serveur d’IA</label></textBox></presentation>
      <presentation id="AIDailyLimit"><decimalTextBox refId="AIDailyLimit" defaultValue="100">Requêtes</decimalTextBox></presentation>
      <presentation id="HiddenContentSources"><multiTextBox refId="HiddenContentSources">Une valeur par ligne</multiTextBox></presentation>
      <presentation id="RefreshMinutes"><decimalTextBox refId="RefreshMinutes" defaultValue="5">Minutes</decimalTextBox></presentation>
      <presentation id="ClaudeCodePath"><textBox refId="ClaudeCodePath"><label>Chemin de Claude Code</label></textBox></presentation>
      <presentation id="MicrosoftTenant"><textBox refId="MicrosoftTenant"><label>Tenant Microsoft 365</label></textBox></presentation>
      <presentation id="MicrosoftClientID"><textBox refId="MicrosoftClientID"><label>ID client Microsoft 365</label></textBox></presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
